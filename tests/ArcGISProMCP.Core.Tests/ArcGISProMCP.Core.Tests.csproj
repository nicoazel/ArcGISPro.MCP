<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Every descriptor the add-in registry published, owned by Operations.Tests (DescriptorGuardTests). -->
    <None Include="../ArcGISProMCP.Operations.Tests/Fixtures/operation-descriptors.json" Link="Fixtures/operation-descriptors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ArcGISProMCP.Core/ArcGISProMCP.Core.csproj" />
    <!-- Operation schemas depend only on Core, so the tests use the exact production schemas. -->
    <ProjectReference Include="../../src/ArcGISProMCP.Operations/ArcGISProMCP.Operations.csproj" />
  </ItemGroup>
</Project>
