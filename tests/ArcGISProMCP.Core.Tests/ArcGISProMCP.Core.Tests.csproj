<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ArcGISProMCP.Core/ArcGISProMCP.Core.csproj" />
    <!-- Add-in operation schemas depend only on Core, so the tests compile the exact production schemas. -->
    <Compile Include="../../src/ArcGISProMCP.AddIn/Operations/Schemas/*.cs" Link="AddInSchemas/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
