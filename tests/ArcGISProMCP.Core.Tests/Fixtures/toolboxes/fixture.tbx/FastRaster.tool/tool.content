{
    "type": "FunctionTool",
    "displayname": "$rc:title",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "GPU",
        "mCPU",
        "spark",
        "output_no_memory",
        "overwrite_on"
    ],
    "params": {
        "in_raster": {
            "displayname": "$rc:in_raster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "out_raster": {
            "direction": "out",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            }
        }
    }
}
