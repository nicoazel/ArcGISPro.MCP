{
    "type": "FunctionTool",
    "guid": "{00000000-0000-0000-0000-000000000001}",
    "displayname": "$rc:title",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU",
        "overwrite_on"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "distance": {
            "display_order": "2",
            "displayname": "$rc:distance.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPLinearUnit"
                    },
                    {
                        "type": "Field"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Double"
                        ]
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:distance.descr"
        },
        "side": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:side.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FULL",
                        "code": "$rc:side.domain.FULL"
                    },
                    {
                        "value": "LEFT",
                        "code": "$rc:side.domain.LEFT"
                    },
                    {
                        "value": "RIGHT",
                        "code": "$rc:side.domain.RIGHT"
                    }
                ]
            },
            "value": "FULL",
            "description": "$rc:side.descr"
        },
        "zone_count": {
            "type": "derived",
            "direction": "out",
            "display_order": "9",
            "displayname": "$rc:zone_count.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "0"
        },
        "dissolve": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:dissolve.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DISSOLVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DISSOLVE"
                    }
                ]
            },
            "value": "false"
        },
        "dissolve_fields": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:dissolve_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ]
        },
        "segments": {
            "type": "optional",
            "display_order": "6",
            "category": "$rc:category.advanced",
            "displayname": "$rc:segments.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "8"
        },
        "ratio": {
            "type": "optional",
            "display_order": "8",
            "category": "$rc:category.advanced",
            "displayname": "$rc:missing.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "false",
                    "val": "0"
                }
            }
        },
        "classes": {
            "type": "optional",
            "display_order": "7",
            "category": "$rc:category.advanced",
            "displayname": "$rc:classes.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPLong"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "1",
                        "code": "1"
                    },
                    {
                        "type": "GPLong",
                        "value": "2",
                        "code": "2"
                    },
                    {
                        "type": "GPLong",
                        "value": "6",
                        "code": "6"
                    }
                ]
            }
        },
        "report_file": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:report_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "csv",
                    "txt"
                ]
            },
            "enabled": "false"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
