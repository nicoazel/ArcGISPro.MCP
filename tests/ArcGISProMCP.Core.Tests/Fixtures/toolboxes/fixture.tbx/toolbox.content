{
    "version": "1.0",
    "alias": "fixture",
    "displayname": "$rc:title",
    "description": "$rc:descr",
    "toolsets": {
        "<root>": {
            "tools": [
                "OldBuffer"
            ]
        },
        "$rc:toolset1.name": {
            "tools": [
                "BufferZones",
                "EraseRows:EraseRows_.tool",
                "AppendRecords",
                "CountRecords",
                "FastRaster"
            ]
        },
        "$rc:toolset2.name": {
            "tools": [
                "ScriptSummary",
                "PySummarize",
                "CalcExpression",
                "GeocodeOnline"
            ]
        }
    }
}
