<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The server's Content items (skills/*.skill.json) flow to this output directory through the reference. -->
    <ProjectReference Include="../../src/ArcGISProMCP.Server/ArcGISProMCP.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Snapshots are read from and (with UPDATE_SNAPSHOTS=1) rewritten in the source tree. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SnapshotDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/Snapshots</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
