<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host-neutral ArcGIS Pro operation logic: descriptors, schemas, argument validation and result
    shaping. It must never reference the ArcGIS Pro SDK; ArcGIS-backed services live in the add-in.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArcGISProMCP.Operations</RootNamespace>
    <AssemblyName>ArcGISProMCP.Operations</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcGISProMCP.Core/ArcGISProMCP.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArcGISProMCP.AddIn" />
    <InternalsVisibleTo Include="ArcGISProMCP.Operations.Tests" />
    <InternalsVisibleTo Include="ArcGISProMCP.Core.Tests" />
  </ItemGroup>
</Project>
