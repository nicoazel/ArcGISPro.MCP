<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A development and evaluation host: the add-in's real bridge handler, registry and approval
    queue over a fake in-memory project, served on the real named pipe with a discovery record.
    Never shipped: tools/package-release.ps1 publishes only src/ArcGISProMCP.Server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArcGISProMCP.FakeHost</RootNamespace>
    <AssemblyName>ArcGISProMCP.FakeHost</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tests/ArcGISProMCP.Testing/ArcGISProMCP.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="scenarios/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
