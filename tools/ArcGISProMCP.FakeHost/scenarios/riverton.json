  "workflows": [
    {
      "id": "riverton.parcel-review",
      "version": "1.0.0",
      "title": "Riverton parcel review",
      "summary": "Queries parcels matching a where clause, selects them in the City map and captures the map for review.",
      "tags": [
        "parcels",
        "review",
        "selection"
      ],
      "requiredCapabilities": [],
      "parameters": [
        {
          "name": "where",
          "type": "string",
          "required": false,
          "defaultValue": "1=1",
          "description": "Attribute filter, for example ZONE = 'C1'."
        }
      ],
      "steps": [
        {
          "id": "inspect",
          "operation": "project.get",
          "arguments": {},
          "dependsOn": []
        },
        {
          "id": "query",
          "operation": "feature.query",
          "arguments": {
            "layer": "Parcels",
            "where": "${parameters.where}",
            "fields": [
              "PARCEL_ID",
              "ZONE",
              "OWNER"
            ],
            "limit": 50
          },
          "dependsOn": [
            "inspect"
          ]
        },
        {
          "id": "select",
          "operation": "feature.select",
          "arguments": {
            "layer": "Parcels",
            "where": "${parameters.where}",
            "mode": "new"
          },
          "dependsOn": [
            "query"
          ]
        },
        {
          "id": "capture",
          "operation": "view.capture",
          "arguments": {
            "view": "active-map",
            "width": 800,
            "height": 600
          },
          "dependsOn": [
            "select"
          ],
          "expectedObservation": "selected-parcels-map-png"
        }
      ]
    }
  ]
