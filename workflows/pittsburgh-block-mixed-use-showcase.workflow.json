{
  "id": "workflow.pittsburgh-block-mixed-use-showcase",
  "version": "1.1.0",
  "title": "Illustrative Pittsburgh block mixed-use showcase",
  "summary": "Presents a reproducible, illustrative Pittsburgh block study with varied massing, active uses, connected public realm, and three coordinated final layout frames.",
  "tags": ["illustrative", "pittsburgh", "urban-design", "mixed-use", "massing", "public-realm", "layout"],
  "requiredCapabilities": ["maps", "layouts", "visual-observations"],
  "parameters": [
    { "name": "massingSource", "type": "path", "required": true, "description": "EPSG:2272 illustrative Z-enabled multipatch massing generated by create-pittsburgh-block-showcase.py." },
    { "name": "programSource", "type": "path", "required": true, "description": "EPSG:2272 illustrative building program footprints generated by create-pittsburgh-block-showcase.py." },
    { "name": "publicRealmSource", "type": "path", "required": true, "description": "EPSG:2272 illustrative plazas, green links, and pedestrian mews." },
    { "name": "streetsSource", "type": "path", "required": true, "description": "EPSG:2272 illustrative street and pedestrian network." },
    { "name": "blocksSource", "type": "path", "required": true, "description": "EPSG:2272 block-outline context for the study." },
    { "name": "contextSource", "type": "path", "required": true, "description": "EPSG:2272 existing-building fixture context." }
  ],
  "steps": [
    { "id": "inspect", "operation": "project.get", "arguments": {}, "dependsOn": [] },
    { "id": "ensure-scene", "operation": "map.ensure", "arguments": { "name": "Pittsburgh Showcase 3D", "type": "scene", "basemap": "GrayVector" }, "dependsOn": ["inspect"] },
    { "id": "ensure-program", "operation": "map.ensure", "arguments": { "name": "Pittsburgh Showcase Program", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-scene"] },
    { "id": "ensure-realm", "operation": "map.ensure", "arguments": { "name": "Pittsburgh Showcase Public Realm", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-program"] },

    { "id": "scene-massing", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase 3D", "source": "${parameters.massingSource}", "name": "Proposed Massing" }, "dependsOn": ["ensure-realm"] },
    { "id": "scene-ground-relative", "operation": "layer.set-elevation", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "Proposed Massing", "mode": "relative-to-ground", "offset": 0, "verticalExaggeration": 1 }, "dependsOn": ["scene-massing"] },
    { "id": "style-scene-massing", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "Proposed Massing", "color": "#C7474E", "outlineColor": "#5B1E2B", "outlineWidth": 0.65 }, "dependsOn": ["scene-ground-relative"] },
    { "id": "scene-realm", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase 3D", "source": "${parameters.publicRealmSource}", "name": "Connected Public Realm" }, "dependsOn": ["style-scene-massing"] },
    { "id": "style-scene-realm", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "Connected Public Realm", "color": "#75A86B", "outlineColor": "#285843", "outlineWidth": 0.65 }, "dependsOn": ["scene-realm"] },
    { "id": "scene-streets", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase 3D", "source": "${parameters.streetsSource}", "name": "Street Network" }, "dependsOn": ["style-scene-realm"] },
    { "id": "style-scene-streets", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "Street Network", "color": "#53616A", "size": 0.8, "outlineColor": "#53616A", "outlineWidth": 0 }, "dependsOn": ["scene-streets"] },
    { "id": "scene-blocks", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase 3D", "source": "${parameters.blocksSource}", "name": "City Blocks" }, "dependsOn": ["style-scene-streets"] },
    { "id": "style-scene-blocks", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "City Blocks", "color": "#E7E0D8", "outlineColor": "#8A7E72", "outlineWidth": 0.4 }, "dependsOn": ["scene-blocks"] },
    { "id": "fade-scene-blocks", "operation": "layer.set-appearance", "arguments": { "map": "Pittsburgh Showcase 3D", "layer": "City Blocks", "transparency": 55 }, "dependsOn": ["style-scene-blocks"] },

    { "id": "program-buildings", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Program", "source": "${parameters.programSource}", "name": "Mixed-Use Program" }, "dependsOn": ["fade-scene-blocks"] },
    { "id": "style-program", "operation": "symbology.set-unique-values", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Mixed-Use Program", "field": "program", "defaultColor": "#D8D2C8", "classes": [ { "value": "Housing", "label": "Housing", "color": "#D9A75B" }, { "value": "Retail", "label": "Retail", "color": "#C86E4C" }, { "value": "Hospitality", "label": "Hospitality", "color": "#B96D8D" }, { "value": "Workspace", "label": "Workspace", "color": "#7369A8" }, { "value": "Civic", "label": "Civic", "color": "#4E93A5" } ] }, "dependsOn": ["program-buildings"] },
    { "id": "label-program", "operation": "label.configure", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Mixed-Use Program", "enabled": true, "expression": "Replace($feature.name, ' ', TextFormatting.NewLine)", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 5.8, "color": "#452A31" }, "dependsOn": ["style-program"] },
    { "id": "program-realm", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Program", "source": "${parameters.publicRealmSource}", "name": "Public Realm" }, "dependsOn": ["label-program"] },
    { "id": "style-program-realm", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Public Realm", "color": "#8FCB8A", "outlineColor": "#3F7656", "outlineWidth": 0.7 }, "dependsOn": ["program-realm"] },
    { "id": "program-streets", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Program", "source": "${parameters.streetsSource}", "name": "Street Context" }, "dependsOn": ["style-program-realm"] },
    { "id": "style-program-streets", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Street Context", "color": "#65727A", "size": 0.65, "outlineColor": "#65727A", "outlineWidth": 0 }, "dependsOn": ["program-streets"] },
    { "id": "program-blocks", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Program", "source": "${parameters.blocksSource}", "name": "Block Structure" }, "dependsOn": ["style-program-streets"] },
    { "id": "style-program-blocks", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Block Structure", "color": "#EAE4DA", "outlineColor": "#6E6258", "outlineWidth": 0.5 }, "dependsOn": ["program-blocks"] },
    { "id": "fade-program-blocks", "operation": "layer.set-appearance", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Block Structure", "transparency": 82 }, "dependsOn": ["style-program-blocks"] },

    { "id": "realm-context", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Public Realm", "source": "${parameters.contextSource}", "name": "Existing Building Context" }, "dependsOn": ["fade-program-blocks"] },
    { "id": "style-realm-context", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Existing Building Context", "color": "#D4D5D0", "outlineColor": "#8A8D84", "outlineWidth": 0.25 }, "dependsOn": ["realm-context"] },
    { "id": "realm-blocks", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Public Realm", "source": "${parameters.blocksSource}", "name": "Block Structure" }, "dependsOn": ["style-realm-context"] },
    { "id": "style-realm-blocks", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Block Structure", "color": "#F0ECE5", "outlineColor": "#9A8E80", "outlineWidth": 0.45 }, "dependsOn": ["realm-blocks"] },
    { "id": "fade-realm-blocks", "operation": "layer.set-appearance", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Block Structure", "transparency": 88 }, "dependsOn": ["style-realm-blocks"] },
    { "id": "realm-public", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Public Realm", "source": "${parameters.publicRealmSource}", "name": "Connected Public Realm" }, "dependsOn": ["fade-realm-blocks"] },
    { "id": "style-realm-public", "operation": "symbology.set-unique-values", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Connected Public Realm", "field": "realm_type", "defaultColor": "#9CCA83", "classes": [ { "value": "pedestrian mews", "label": "Pedestrian mews", "color": "#74B96B" }, { "value": "plaza", "label": "Plaza", "color": "#E1C46A" }, { "value": "green link", "label": "Green link", "color": "#4E9B63" }, { "value": "parklet", "label": "Parklet", "color": "#6AB077" }, { "value": "shared street", "label": "Shared street", "color": "#A6C9D6" } ] }, "dependsOn": ["realm-public"] },
    { "id": "label-realm", "operation": "label.configure", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Connected Public Realm", "enabled": true, "expression": "$feature.name", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 8, "color": "#285843" }, "dependsOn": ["style-realm-public"] },
    { "id": "realm-streets", "operation": "layer.add", "arguments": { "map": "Pittsburgh Showcase Public Realm", "source": "${parameters.streetsSource}", "name": "Street Network" }, "dependsOn": ["label-realm"] },
    { "id": "style-realm-streets", "operation": "symbology.set-simple", "arguments": { "map": "Pittsburgh Showcase Public Realm", "layer": "Street Network", "color": "#596871", "size": 0.7, "outlineColor": "#596871", "outlineWidth": 0 }, "dependsOn": ["realm-streets"] },

    { "id": "ensure-layout", "operation": "layout.ensure", "arguments": { "name": "Illustrative Pittsburgh Block Showcase", "width": 17, "height": 11 }, "dependsOn": ["style-realm-streets"] },
    { "id": "scene-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "map": "Pittsburgh Showcase 3D", "name": "Massing Scene", "x": 0.55, "y": 1.25, "width": 9.45, "height": 8.2 }, "dependsOn": ["ensure-layout"] },
    { "id": "program-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "map": "Pittsburgh Showcase Program", "name": "Program Plan", "x": 10.25, "y": 5.7, "width": 6.2, "height": 3.75 }, "dependsOn": ["scene-frame"] },
    { "id": "realm-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "map": "Pittsburgh Showcase Public Realm", "name": "Public Realm Plan", "x": 10.25, "y": 1.25, "width": 6.2, "height": 3.75 }, "dependsOn": ["program-frame"] },
    { "id": "title", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "title", "text": "PITTSBURGH BLOCK STUDY  /  MIXED-USE + PUBLIC REALM", "x": 0.55, "y": 10.36, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 22, "color": "#442936" }, "dependsOn": ["realm-frame"] },
    { "id": "subtitle", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "subtitle", "text": "A deliberately illustrative, EPSG:2272 fixture study: varied housing, active uses, workspace, civic program, and connected streetscape", "x": 0.55, "y": 9.96, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 8.5, "color": "#6B5C65" }, "dependsOn": ["title"] },
    { "id": "heading-scene", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "heading-scene", "text": "01  GROUND-RELATIVE 3D MASSING", "x": 0.55, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#442936" }, "dependsOn": ["subtitle"] },
    { "id": "heading-program", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "heading-program", "text": "02  ACTIVE PROGRAM MIX", "x": 10.25, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10, "color": "#442936" }, "dependsOn": ["heading-scene"] },
    { "id": "heading-realm", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "heading-realm", "text": "03  CONNECTED PUBLIC REALM", "x": 10.25, "y": 5.18, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10, "color": "#442936" }, "dependsOn": ["heading-program"] },
    { "id": "note", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "note", "text": "DESIGN STUDY: consolidate daily uses around a walkable civic mews, main-street retail, and a fine-grained network of plazas and green links.", "x": 0.55, "y": 0.72, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 8.3, "color": "#442936" }, "dependsOn": ["heading-realm"] },
    { "id": "disclaimer", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "disclaimer", "text": "Illustrative synthetic geometry derived from EPSG:2272 test fixtures. Not a site plan, survey, zoning determination, feasibility study, or City of Pittsburgh proposal.", "x": 0.55, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 7, "color": "#756D70" }, "dependsOn": ["note"] },
    { "id": "fit-scene", "operation": "layout.set-frame-extent", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Massing Scene", "layer": "Proposed Massing", "padding": 2.6, "heading": 325, "pitch": -42 }, "dependsOn": ["disclaimer"] },
    { "id": "fit-program", "operation": "layout.set-frame-extent", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Program Plan", "layer": "Mixed-Use Program", "padding": 2.1 }, "dependsOn": ["fit-scene"] },
    { "id": "fit-realm", "operation": "layout.set-frame-extent", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Public Realm Plan", "layer": "Connected Public Realm", "padding": 2.4 }, "dependsOn": ["fit-program"] },
    { "id": "north", "operation": "layout.ensure-surround", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Program Plan", "name": "Pittsburgh North", "kind": "north-arrow", "x": 15.85, "y": 8.5, "width": 0.4, "height": 0.68 }, "dependsOn": ["fit-realm"] },
    { "id": "scale", "operation": "layout.ensure-surround", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Program Plan", "name": "Pittsburgh Scale", "kind": "scale-bar", "x": 10.55, "y": 5.92, "width": 1.7, "height": 0.28 }, "dependsOn": ["north"] },
    { "id": "legend", "operation": "layout.ensure-surround", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "frame": "Program Plan", "name": "Pittsburgh Program Legend", "kind": "legend", "x": 8.0, "y": 1.55, "width": 1.7, "height": 2.05 }, "dependsOn": ["scale"] },
    { "id": "dynamic-status", "operation": "layout.set-text", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase", "name": "dynamic-status", "text": "PROJECT  <dyn type=\"project\" property=\"name\"/>  /  GENERATED  <dyn type=\"date\" format=\"short\"/>  /  PLAN SCALE  <dyn type=\"mapFrame\" name=\"Program Plan\" property=\"camera.scale\" preStr=\"1:\" decimalPlaces=\"0\"/>", "x": 10.25, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 6.5, "color": "#756D70" }, "dependsOn": ["legend"] },
    { "id": "stats-units", "operation": "table.statistics", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Mixed-Use Program", "field": "res_units" }, "dependsOn": ["dynamic-status"] },
    { "id": "stats-jobs", "operation": "table.statistics", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Mixed-Use Program", "field": "jobs" }, "dependsOn": ["stats-units"] },
    { "id": "stats-gross-area", "operation": "table.statistics", "arguments": { "map": "Pittsburgh Showcase Program", "layer": "Mixed-Use Program", "field": "gross_sf" }, "dependsOn": ["stats-jobs"] },
    { "id": "activate-layout", "operation": "layout.activate", "arguments": { "layout": "Illustrative Pittsburgh Block Showcase" }, "dependsOn": ["stats-gross-area"] },
    { "id": "capture", "operation": "view.capture", "arguments": { "view": "layout", "layout": "Illustrative Pittsburgh Block Showcase", "width": 2400, "height": 1553 }, "dependsOn": ["activate-layout"], "expectedObservation": "pittsburgh-block-showcase-layout-png" }
  ]
}
