{
  "id": "workflow.east-liberty-presentation",
  "version": "1.0.1",
  "title": "East Liberty illustrative master-plan presentation",
  "summary": "Present the live Rhino courtyard proposal alongside land-use and mobility context; capture a three-map landscape sheet.",
  "tags": [
    "demo",
    "cartography",
    "rhino",
    "layout"
  ],
  "requiredCapabilities": [
    "maps",
    "layouts",
    "visual-observations"
  ],
  "parameters": [
    {
      "name": "proposalSource",
      "type": "path",
      "required": true,
      "description": "Absolute native path to the synchronized ProposedBuildings feature class."
    }
  ],
  "steps": [
    {
      "id": "hide-placeholder",
      "operation": "layer.set-appearance",
      "arguments": {
        "map": "Buildings-SiteDesign",
        "layer": "Proposed Site Design",
        "visible": false
      },
      "dependsOn": []
    },
    {
      "id": "clear-zoning-labels",
      "operation": "label.configure",
      "arguments": {
        "map": "Zoning",
        "layer": "Zoning",
        "enabled": false
      },
      "dependsOn": [
        "hide-placeholder"
      ]
    },
    {
      "id": "simplify-street-labels",
      "operation": "label.configure",
      "arguments": {
        "map": "Transit",
        "layer": "Transit",
        "enabled": false
      },
      "dependsOn": [
        "clear-zoning-labels"
      ]
    },
    {
      "id": "style-existing",
      "operation": "symbology.set-simple",
      "arguments": {
        "map": "Buildings-SiteDesign",
        "layer": "Existing Buildings",
        "color": "#DDE2DE",
        "outlineColor": "#9BA79F",
        "outlineWidth": 0.4
      },
      "dependsOn": [
        "simplify-street-labels"
      ]
    },
    {
      "id": "show-existing",
      "operation": "layer.set-appearance",
      "arguments": {
        "map": "Buildings-SiteDesign",
        "layer": "Existing Buildings",
        "visible": true,
        "transparency": 0
      },
      "dependsOn": [
        "style-existing"
      ]
    },
    {
      "id": "style-proposal",
      "operation": "symbology.set-simple",
      "arguments": {
        "map": "Buildings-SiteDesign",
        "layer": "Rhino Proposal",
        "color": "#347B60",
        "outlineColor": "#163E2C",
        "outlineWidth": 0.8
      },
      "dependsOn": [
        "show-existing"
      ]
    },
    {
      "id": "label-proposal",
      "operation": "label.configure",
      "arguments": {
        "map": "Buildings-SiteDesign",
        "layer": "Rhino Proposal",
        "enabled": true,
        "expression": "$feature.Name",
        "fontFamily": "Aptos",
        "fontStyle": "Semibold",
        "size": 8,
        "color": "#163E2C"
      },
      "dependsOn": [
        "style-proposal"
      ]
    },
    {
      "id": "proposal-zoning",
      "operation": "layer.add",
      "arguments": {
        "map": "Zoning",
        "name": "Proposal Focus",
        "source": "${parameters.proposalSource}"
      },
      "dependsOn": [
        "label-proposal"
      ]
    },
    {
      "id": "style-focus-zoning",
      "operation": "symbology.set-simple",
      "arguments": {
        "map": "Zoning",
        "layer": "Proposal Focus",
        "color": "#347B60",
        "outlineColor": "#FFFFFF",
        "outlineWidth": 1.1
      },
      "dependsOn": [
        "proposal-zoning"
      ]
    },
    {
      "id": "proposal-transit",
      "operation": "layer.add",
      "arguments": {
        "map": "Transit",
        "name": "Proposal Focus",
        "source": "${parameters.proposalSource}"
      },
      "dependsOn": [
        "style-focus-zoning"
      ]
    },
    {
      "id": "style-focus-transit",
      "operation": "symbology.set-simple",
      "arguments": {
        "map": "Transit",
        "layer": "Proposal Focus",
        "color": "#347B60",
        "outlineColor": "#FFFFFF",
        "outlineWidth": 1.1
      },
      "dependsOn": [
        "proposal-transit"
      ]
    },
    {
      "id": "create-sheet",
      "operation": "layout.ensure",
      "arguments": {
        "name": "East Liberty Concept Master Plan",
        "width": 17,
        "height": 11
      },
      "dependsOn": [
        "style-focus-transit"
      ]
    },
    {
      "id": "hero-frame",
      "operation": "layout.add-map-frame",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "map": "Buildings-SiteDesign",
        "name": "Site Plan",
        "x": 0.6,
        "y": 1.25,
        "width": 9.35,
        "height": 8.25
      },
      "dependsOn": [
        "create-sheet"
      ]
    },
    {
      "id": "landuse-frame",
      "operation": "layout.add-map-frame",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "map": "Zoning",
        "name": "Land Use Context",
        "x": 10.25,
        "y": 5.7,
        "width": 6.15,
        "height": 3.8
      },
      "dependsOn": [
        "hero-frame"
      ]
    },
    {
      "id": "mobility-frame",
      "operation": "layout.add-map-frame",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "map": "Transit",
        "name": "Mobility Context",
        "x": 10.25,
        "y": 1.25,
        "width": 6.15,
        "height": 3.8
      },
      "dependsOn": [
        "landuse-frame"
      ]
    },
    {
      "id": "sheet-title",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "sheet-title",
        "text": "EAST LIBERTY  /  COURTYARD DISTRICT",
        "x": 0.6,
        "y": 10.35,
        "size": 25,
        "fontFamily": "Aptos",
        "fontStyle": "Bold",
        "color": "#233E32"
      },
      "dependsOn": [
        "mobility-frame"
      ]
    },
    {
      "id": "sheet-subtitle",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "sheet-subtitle",
        "text": "CONCEPT MASTER PLAN     •     PITTSBURGH, PENNSYLVANIA     •     ARCGIS PRO + RHINO.INSIDE",
        "x": 0.6,
        "y": 9.95,
        "size": 9,
        "fontFamily": "Aptos",
        "fontStyle": "Regular",
        "color": "#566960"
      },
      "dependsOn": [
        "sheet-title"
      ]
    },
    {
      "id": "site-heading",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "site-heading",
        "text": "01   SITE PLAN & PROPOSED BUILDINGS",
        "x": 0.6,
        "y": 9.64,
        "size": 12,
        "fontFamily": "Aptos",
        "fontStyle": "Bold",
        "color": "#233E32"
      },
      "dependsOn": [
        "sheet-subtitle"
      ]
    },
    {
      "id": "landuse-heading",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "landuse-heading",
        "text": "02   LAND USE / ZONING STUDY",
        "x": 10.25,
        "y": 9.64,
        "size": 11,
        "fontFamily": "Aptos",
        "fontStyle": "Bold",
        "color": "#233E32"
      },
      "dependsOn": [
        "site-heading"
      ]
    },
    {
      "id": "mobility-heading",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "mobility-heading",
        "text": "03   MOBILITY / STREET NETWORK",
        "x": 10.25,
        "y": 5.22,
        "size": 11,
        "fontFamily": "Aptos",
        "fontStyle": "Bold",
        "color": "#233E32"
      },
      "dependsOn": [
        "landuse-heading"
      ]
    },
    {
      "id": "design-note",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "design-note",
        "text": "9 COURTYARD BUILDINGS    /    12–24 m CONCEPT MASSING    /    545 EXISTING BUILDINGS IN RHINO CONTEXT",
        "x": 0.6,
        "y": 0.76,
        "size": 9,
        "fontFamily": "Aptos",
        "fontStyle": "Regular",
        "color": "#233E32"
      },
      "dependsOn": [
        "mobility-heading"
      ]
    },
    {
      "id": "source-note",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "source-note",
        "text": "Illustrative development concept. Land-use parcels and street centerlines are test fixtures; not authoritative zoning or transit service data.",
        "x": 0.6,
        "y": 0.46,
        "size": 8,
        "fontFamily": "Aptos",
        "fontStyle": "Regular",
        "color": "#66766E"
      },
      "dependsOn": [
        "design-note"
      ]
    },
    {
      "id": "workflow-note",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "workflow-note",
        "text": "C# SDK cartography  •  McNeel MCP modeling  •  Rhino.Inside geometry sync",
        "x": 0.6,
        "y": 0.23,
        "size": 8,
        "fontFamily": "Aptos",
        "fontStyle": "Regular",
        "color": "#66766E"
      },
      "dependsOn": [
        "source-note"
      ]
    },
    {
      "id": "frame-proposal",
      "operation": "layout.set-frame-extent",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "frame": "Site Plan",
        "layer": "Rhino Proposal",
        "padding": 2.2
      },
      "dependsOn": [
        "workflow-note"
      ]
    },
    {
      "id": "categorize-landuse",
      "operation": "symbology.set-unique-values",
      "arguments": {
        "map": "Zoning",
        "layer": "Zoning",
        "field": "land_use_1",
        "defaultColor": "#DBDDD8",
        "classes": [
          {
            "value": "single_family",
            "label": "Single-family",
            "color": "#E6D9BB"
          },
          {
            "value": "multifamily",
            "label": "Multifamily",
            "color": "#D5B37B"
          },
          {
            "value": "retail_commercial",
            "label": "Retail / commercial",
            "color": "#CF9F8D"
          },
          {
            "value": "office",
            "label": "Office",
            "color": "#B5AEC9"
          },
          {
            "value": "industrial",
            "label": "Industrial",
            "color": "#A8ACB8"
          },
          {
            "value": "parks_recreation",
            "label": "Parks / recreation",
            "color": "#B3CBA1"
          },
          {
            "value": "civic_facilities",
            "label": "Civic",
            "color": "#9FBDC7"
          }
        ]
      },
      "dependsOn": [
        "frame-proposal"
      ]
    },
    {
      "id": "refine-streets",
      "operation": "symbology.set-simple",
      "arguments": {
        "map": "Transit",
        "layer": "Transit",
        "color": "#568581",
        "size": 1
      },
      "dependsOn": [
        "categorize-landuse"
      ]
    },
    {
      "id": "clear-selection-0",
      "operation": "map.clear-selection",
      "arguments": {
        "map": "Buildings-SiteDesign"
      },
      "dependsOn": [
        "refine-streets"
      ]
    },
    {
      "id": "clear-selection-1",
      "operation": "map.clear-selection",
      "arguments": {
        "map": "Zoning"
      },
      "dependsOn": [
        "clear-selection-0"
      ]
    },
    {
      "id": "clear-selection-2",
      "operation": "map.clear-selection",
      "arguments": {
        "map": "Transit"
      },
      "dependsOn": [
        "clear-selection-1"
      ]
    },
    {
      "id": "north-arrow",
      "operation": "layout.ensure-surround",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "frame": "Site Plan",
        "name": "Site North",
        "kind": "north-arrow",
        "x": 9.2,
        "y": 8.5,
        "width": 0.4,
        "height": 0.7
      },
      "dependsOn": [
        "clear-selection-2"
      ]
    },
    {
      "id": "scale-bar",
      "operation": "layout.ensure-surround",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "frame": "Site Plan",
        "name": "Site Scale",
        "kind": "scale-bar",
        "x": 0.85,
        "y": 1.5,
        "width": 2,
        "height": 0.3
      },
      "dependsOn": [
        "north-arrow"
      ]
    },
    {
      "id": "key-0",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-0",
        "text": "■ Single-family",
        "x": 10.25,
        "y": 0.97,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#B29965"
      },
      "dependsOn": [
        "scale-bar"
      ]
    },
    {
      "id": "key-1",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-1",
        "text": "■ Multifamily",
        "x": 11.8,
        "y": 0.97,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#B58B4D"
      },
      "dependsOn": [
        "key-0"
      ]
    },
    {
      "id": "key-2",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-2",
        "text": "■ Commercial",
        "x": 13.35,
        "y": 0.97,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#B1725D"
      },
      "dependsOn": [
        "key-1"
      ]
    },
    {
      "id": "key-3",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-3",
        "text": "■ Office",
        "x": 14.9,
        "y": 0.97,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#827398"
      },
      "dependsOn": [
        "key-2"
      ]
    },
    {
      "id": "key-4",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-4",
        "text": "■ Industrial",
        "x": 10.25,
        "y": 0.74,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#7E8190"
      },
      "dependsOn": [
        "key-3"
      ]
    },
    {
      "id": "key-5",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-5",
        "text": "■ Parks",
        "x": 11.8,
        "y": 0.74,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#719661"
      },
      "dependsOn": [
        "key-4"
      ]
    },
    {
      "id": "key-6",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-6",
        "text": "■ Civic",
        "x": 13.35,
        "y": 0.74,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#5D8F9B"
      },
      "dependsOn": [
        "key-5"
      ]
    },
    {
      "id": "key-7",
      "operation": "layout.set-text",
      "arguments": {
        "layout": "East Liberty Concept Master Plan",
        "name": "key-7",
        "text": "■ Other",
        "x": 14.9,
        "y": 0.74,
        "size": 7.5,
        "fontFamily": "Aptos",
        "color": "#9A9D94"
      },
      "dependsOn": [
        "key-6"
      ]
    },
    {
      "id": "save-sheet",
      "operation": "project.save",
      "arguments": {},
      "dependsOn": [
        "key-7"
      ]
    },
    {
      "id": "open-sheet",
      "operation": "layout.activate",
      "arguments": {
        "layout": "East Liberty Concept Master Plan"
      },
      "dependsOn": [
        "save-sheet"
      ]
    },
    {
      "id": "capture-sheet",
      "operation": "view.capture",
      "arguments": {
        "view": "layout",
        "layout": "East Liberty Concept Master Plan",
        "width": 2400,
        "height": 1553
      },
      "dependsOn": [
        "open-sheet"
      ]
    }
  ]
}
