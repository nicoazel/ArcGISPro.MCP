{
  "id": "workflow.master-cartography",
  "version": "1.0.0",
  "title": "Three-map master cartography",
  "summary": "Build zoning, transit, and buildings/site-design maps, compose one landscape layout, and capture visual evidence.",
  "tags": ["cartography", "multi-map", "layout", "master-plan"],
  "requiredCapabilities": ["maps", "layouts", "visual-observations"],
  "parameters": [
    { "name": "zoningSource", "type": "path", "required": true, "description": "Absolute path or service URL for zoning polygons." },
    { "name": "transitSource", "type": "path", "required": true, "description": "Absolute path or service URL for transit lines or stops." },
    { "name": "buildingsSource", "type": "path", "required": true, "description": "Absolute path or service URL for existing building context." },
    { "name": "siteDesignSource", "type": "path", "required": true, "description": "Absolute path or service URL for the proposed site-design feature layer." },
    { "name": "zoningLabelExpression", "type": "string", "required": false, "defaultValue": "$feature.ZONE", "description": "Arcade expression for zoning labels." },
    { "name": "transitLabelExpression", "type": "string", "required": false, "defaultValue": "$feature.NAME", "description": "Arcade expression for transit labels." },
    { "name": "siteLabelExpression", "type": "string", "required": false, "defaultValue": "$feature.NAME", "description": "Arcade expression for proposed-building labels." }
  ],
  "steps": [
    { "id": "inspect-project", "operation": "project.get", "arguments": {}, "dependsOn": [], "expectedObservation": "project-state" },
    { "id": "ensure-zoning-map", "operation": "map.ensure", "arguments": { "name": "Zoning", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["inspect-project"] },
    { "id": "ensure-transit-map", "operation": "map.ensure", "arguments": { "name": "Transit", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-zoning-map"] },
    { "id": "ensure-buildings-map", "operation": "map.ensure", "arguments": { "name": "Buildings-SiteDesign", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-transit-map"] },
    { "id": "add-zoning", "operation": "layer.add", "arguments": { "map": "Zoning", "source": "${parameters.zoningSource}", "name": "Zoning" }, "dependsOn": ["ensure-buildings-map"] },
    { "id": "style-zoning", "operation": "symbology.set-simple", "arguments": { "map": "Zoning", "layer": "Zoning", "color": "#D9A566", "outlineColor": "#7A5A35", "outlineWidth": 0.6 }, "dependsOn": ["add-zoning"] },
    { "id": "fade-zoning", "operation": "layer.set-appearance", "arguments": { "map": "Zoning", "layer": "Zoning", "visible": true, "transparency": 12 }, "dependsOn": ["style-zoning"] },
    { "id": "label-zoning", "operation": "label.configure", "arguments": { "map": "Zoning", "layer": "Zoning", "enabled": true, "expression": "${parameters.zoningLabelExpression}", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 8.5, "color": "#3B3128" }, "dependsOn": ["fade-zoning"] },
    { "id": "add-transit", "operation": "layer.add", "arguments": { "map": "Transit", "source": "${parameters.transitSource}", "name": "Transit" }, "dependsOn": ["label-zoning"] },
    { "id": "style-transit", "operation": "symbology.set-simple", "arguments": { "map": "Transit", "layer": "Transit", "color": "#007C83", "size": 2.6 }, "dependsOn": ["add-transit"] },
    { "id": "label-transit", "operation": "label.configure", "arguments": { "map": "Transit", "layer": "Transit", "enabled": true, "expression": "${parameters.transitLabelExpression}", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 9, "color": "#064F54" }, "dependsOn": ["style-transit"] },
    { "id": "add-buildings", "operation": "layer.add", "arguments": { "map": "Buildings-SiteDesign", "source": "${parameters.buildingsSource}", "name": "Existing Buildings" }, "dependsOn": ["label-transit"] },
    { "id": "style-buildings", "operation": "symbology.set-simple", "arguments": { "map": "Buildings-SiteDesign", "layer": "Existing Buildings", "color": "#C7C8C4", "outlineColor": "#767A75", "outlineWidth": 0.5 }, "dependsOn": ["add-buildings"] },
    { "id": "fade-buildings", "operation": "layer.set-appearance", "arguments": { "map": "Buildings-SiteDesign", "layer": "Existing Buildings", "visible": true, "transparency": 35 }, "dependsOn": ["style-buildings"] },
    { "id": "add-site-design", "operation": "layer.add", "arguments": { "map": "Buildings-SiteDesign", "source": "${parameters.siteDesignSource}", "name": "Proposed Site Design" }, "dependsOn": ["fade-buildings"] },
    { "id": "style-site-design", "operation": "symbology.set-simple", "arguments": { "map": "Buildings-SiteDesign", "layer": "Proposed Site Design", "color": "#4F8F6A", "outlineColor": "#214F38", "outlineWidth": 1.2 }, "dependsOn": ["add-site-design"] },
    { "id": "label-site-design", "operation": "label.configure", "arguments": { "map": "Buildings-SiteDesign", "layer": "Proposed Site Design", "enabled": true, "expression": "${parameters.siteLabelExpression}", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 8.5, "color": "#173A29" }, "dependsOn": ["style-site-design"] },
    { "id": "activate-site-map", "operation": "map.activate", "arguments": { "map": "Buildings-SiteDesign" }, "dependsOn": ["label-site-design"] },
    { "id": "ensure-layout", "operation": "layout.ensure", "arguments": { "name": "Master Multi-Map", "width": 17, "height": 11 }, "dependsOn": ["activate-site-map"] },
    { "id": "place-zoning", "operation": "layout.add-map-frame", "arguments": { "layout": "Master Multi-Map", "map": "Zoning", "name": "Zoning Overview", "x": 0.5, "y": 1.0, "width": 8.0, "height": 9.2 }, "dependsOn": ["ensure-layout"] },
    { "id": "place-transit", "operation": "layout.add-map-frame", "arguments": { "layout": "Master Multi-Map", "map": "Transit", "name": "Transit Context", "x": 8.75, "y": 5.65, "width": 7.75, "height": 4.55 }, "dependsOn": ["place-zoning"] },
    { "id": "place-site-design", "operation": "layout.add-map-frame", "arguments": { "layout": "Master Multi-Map", "map": "Buildings-SiteDesign", "name": "Buildings and Site Design", "x": 8.75, "y": 1.0, "width": 7.75, "height": 4.35 }, "dependsOn": ["place-transit"] },
    { "id": "save-project", "operation": "project.save", "arguments": {}, "dependsOn": ["place-site-design"] },
    { "id": "activate-layout", "operation": "layout.activate", "arguments": { "layout": "Master Multi-Map" }, "dependsOn": ["save-project"] },
    { "id": "capture-layout", "operation": "view.capture", "arguments": { "view": "layout", "layout": "Master Multi-Map", "width": 2400, "height": 1553 }, "dependsOn": ["activate-layout"], "expectedObservation": "final-layout-png" }
  ]
}
