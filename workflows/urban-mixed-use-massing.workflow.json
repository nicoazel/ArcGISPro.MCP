{
  "id": "workflow.urban-mixed-use-massing",
  "version": "1.0.5",
  "title": "Urban test 3 - mixed-use massing and public realm",
  "summary": "Builds a mixed-use program test with a 3D massing scene, development-program map, existing-fabric map, and exported review sheet.",
  "tags": ["urban-design", "mixed-use", "massing", "scene", "layout", "stress-test"],
  "requiredCapabilities": ["maps", "layouts", "visual-observations"],
  "parameters": [
    { "name": "zoningSource", "type": "path", "required": true, "description": "Illustrative parcel and land-use fixture." },
    { "name": "buildingsSource", "type": "path", "required": true, "description": "Existing building-footprint fixture." },
    { "name": "boundarySource", "type": "path", "required": true, "description": "Illustrative site/public-realm boundary fixture." },
    { "name": "massingSource", "type": "path", "required": true, "description": "Illustrative multipatch massing fixture." },
    { "name": "proposalSource", "type": "path", "required": true, "description": "Synchronized development proposal feature class." }
  ],
  "steps": [
    { "id": "inspect", "operation": "project.get", "arguments": {}, "dependsOn": [] },
    { "id": "ensure-scene", "operation": "map.ensure", "arguments": { "name": "UD3 Mixed Use Massing", "type": "scene", "basemap": "GrayVector" }, "dependsOn": ["inspect"] },
    { "id": "ensure-program", "operation": "map.ensure", "arguments": { "name": "UD3 Mixed Use Program", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-scene"] },
    { "id": "ensure-fabric", "operation": "map.ensure", "arguments": { "name": "UD3 Public Realm Fabric", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-program"] },
    { "id": "scene-massing", "operation": "layer.add", "arguments": { "map": "UD3 Mixed Use Massing", "source": "${parameters.massingSource}", "name": "Proposed Massing" }, "dependsOn": ["ensure-fabric"] },
    { "id": "place-scene-massing", "operation": "layer.set-elevation", "arguments": { "map": "UD3 Mixed Use Massing", "layer": "Proposed Massing", "mode": "relative-to-ground", "offset": 0, "verticalExaggeration": 1 }, "dependsOn": ["scene-massing"] },
    { "id": "style-scene-massing", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Mixed Use Massing", "layer": "Proposed Massing", "color": "#D1485F", "outlineColor": "#6E1C2B", "outlineWidth": 0.7 }, "dependsOn": ["place-scene-massing"] },
    { "id": "scene-buildings", "operation": "layer.add", "arguments": { "map": "UD3 Mixed Use Massing", "source": "${parameters.buildingsSource}", "name": "Existing Context" }, "dependsOn": ["style-scene-massing"] },
    { "id": "style-scene-context", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Mixed Use Massing", "layer": "Existing Context", "color": "#C4C7C6", "outlineColor": "#707674", "outlineWidth": 0.3 }, "dependsOn": ["scene-buildings"] },
    { "id": "scene-boundary", "operation": "layer.add", "arguments": { "map": "UD3 Mixed Use Massing", "source": "${parameters.boundarySource}", "name": "Public Realm" }, "dependsOn": ["style-scene-context"] },
    { "id": "style-scene-boundary", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Mixed Use Massing", "layer": "Public Realm", "color": "#65A987", "outlineColor": "#285A43", "outlineWidth": 0.8 }, "dependsOn": ["scene-boundary"] },
    { "id": "program-parcels", "operation": "layer.add", "arguments": { "map": "UD3 Mixed Use Program", "source": "${parameters.zoningSource}", "name": "Mixed Use Program" }, "dependsOn": ["style-scene-boundary"] },
    { "id": "style-program", "operation": "symbology.set-unique-values", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Mixed Use Program", "field": "land_use_1", "defaultColor": "#D7D5D0", "classes": [ { "value": "multifamily", "label": "Housing", "color": "#D6AA5D" }, { "value": "retail_commercial", "label": "Retail + hospitality", "color": "#C8755F" }, { "value": "office", "label": "Workspace", "color": "#8275A7" }, { "value": "parks_recreation", "label": "Public realm", "color": "#79AA72" }, { "value": "civic_facilities", "label": "Civic use", "color": "#6D9FB1" } ] }, "dependsOn": ["program-parcels"] },
    { "id": "program-proposal", "operation": "layer.add", "arguments": { "map": "UD3 Mixed Use Program", "source": "${parameters.proposalSource}", "name": "Development Program" }, "dependsOn": ["style-program"] },
    { "id": "style-program-proposal", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Development Program", "color": "#D1485F", "outlineColor": "#6E1C2B", "outlineWidth": 1.0 }, "dependsOn": ["program-proposal"] },
    { "id": "label-program", "operation": "label.configure", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Development Program", "enabled": true, "expression": "'Building ' + Text($feature.OBJECTID)", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 8, "color": "#6E1C2B" }, "dependsOn": ["style-program-proposal"] },
    { "id": "fabric-buildings", "operation": "layer.add", "arguments": { "map": "UD3 Public Realm Fabric", "source": "${parameters.buildingsSource}", "name": "Existing Buildings" }, "dependsOn": ["label-program"] },
    { "id": "style-fabric", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Public Realm Fabric", "layer": "Existing Buildings", "color": "#C9CAC6", "outlineColor": "#74766F", "outlineWidth": 0.35 }, "dependsOn": ["fabric-buildings"] },
    { "id": "fabric-boundary", "operation": "layer.add", "arguments": { "map": "UD3 Public Realm Fabric", "source": "${parameters.boundarySource}", "name": "Public Realm Network" }, "dependsOn": ["style-fabric"] },
    { "id": "style-fabric-boundary", "operation": "symbology.set-simple", "arguments": { "map": "UD3 Public Realm Fabric", "layer": "Public Realm Network", "color": "#4C987A", "outlineColor": "#FFFFFF", "outlineWidth": 1.0 }, "dependsOn": ["fabric-boundary"] },
    { "id": "ensure-layout", "operation": "layout.ensure", "arguments": { "name": "Urban Test 3 - Mixed Use Massing", "width": 17, "height": 11 }, "dependsOn": ["style-fabric-boundary"] },
    { "id": "scene-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "map": "UD3 Mixed Use Massing", "name": "Massing Scene", "x": 0.55, "y": 1.25, "width": 9.45, "height": 8.2 }, "dependsOn": ["ensure-layout"] },
    { "id": "program-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "map": "UD3 Mixed Use Program", "name": "Program Mix", "x": 10.25, "y": 5.7, "width": 6.2, "height": 3.75 }, "dependsOn": ["scene-frame"] },
    { "id": "fabric-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "map": "UD3 Public Realm Fabric", "name": "Public Realm Fabric", "x": 10.25, "y": 1.25, "width": 6.2, "height": 3.75 }, "dependsOn": ["program-frame"] },
    { "id": "title", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "title", "text": "URBAN TEST 03  /  MIXED-USE MASSING + PUBLIC REALM", "x": 0.55, "y": 10.36, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 23, "color": "#3D2D35" }, "dependsOn": ["fabric-frame"] },
    { "id": "subtitle", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "subtitle", "text": "Housing, retail/hospitality, workspace, massing, and connected public realm", "x": 0.55, "y": 9.96, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 9, "color": "#6F6067" }, "dependsOn": ["title"] },
    { "id": "heading-scene", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "heading-scene", "text": "01  3D MASSING + URBAN FORM", "x": 0.55, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 11, "color": "#3D2D35" }, "dependsOn": ["subtitle"] },
    { "id": "heading-program", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "heading-program", "text": "02  MIXED-USE PROGRAM", "x": 10.25, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#3D2D35" }, "dependsOn": ["heading-scene"] },
    { "id": "heading-fabric", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "heading-fabric", "text": "03  PUBLIC-REALM FIT", "x": 10.25, "y": 5.18, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#3D2D35" }, "dependsOn": ["heading-program"] },
    { "id": "note", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "note", "text": "TEST HYPOTHESIS: combine housing, retail/hospitality, and workspace around a connected public-realm structure with legible massing.", "x": 0.55, "y": 0.72, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 8.5, "color": "#3D2D35" }, "dependsOn": ["heading-fabric"] },
    { "id": "disclaimer", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "disclaimer", "text": "Illustrative automated test using synthetic geometry; massing and program are not a feasibility, zoning, or market study.", "x": 0.55, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 7.5, "color": "#746D70" }, "dependsOn": ["note"] },
    { "id": "fit-scene", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Massing Scene", "layer": "Proposed Massing", "padding": 2.8, "heading": 325, "pitch": -45 }, "dependsOn": ["disclaimer"] },
    { "id": "fit-program", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Program Mix", "layer": "Development Program", "padding": 2.2 }, "dependsOn": ["fit-scene"] },
    { "id": "fit-fabric", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Public Realm Fabric", "layer": "Public Realm Network", "padding": 2.0 }, "dependsOn": ["fit-program"] },
    { "id": "north", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Program Mix", "name": "Mixed Use North", "kind": "north-arrow", "x": 15.85, "y": 8.5, "width": 0.4, "height": 0.68 }, "dependsOn": ["fit-fabric"] },
    { "id": "scale", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Program Mix", "name": "Mixed Use Scale", "kind": "scale-bar", "x": 10.55, "y": 5.92, "width": 1.7, "height": 0.28 }, "dependsOn": ["north"] },
    { "id": "legend", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "frame": "Program Mix", "name": "Mixed Use Legend", "kind": "legend", "x": 14.35, "y": 5.95, "width": 1.8, "height": 2.0 }, "dependsOn": ["scale"] },
    { "id": "dynamic-status", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 3 - Mixed Use Massing", "name": "dynamic-status", "text": "PROJECT  <dyn type=\"project\" property=\"name\"/>  /  GENERATED  <dyn type=\"date\" format=\"short\"/>  /  SCALE  <dyn type=\"mapFrame\" name=\"Program Mix\" property=\"camera.scale\" preStr=\"1:\" decimalPlaces=\"0\"/>", "x": 10.25, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 6.5, "color": "#746D70" }, "dependsOn": ["legend"] },
    { "id": "stats-area", "operation": "table.statistics", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Mixed Use Program", "field": "area_gross" }, "dependsOn": ["dynamic-status"] },
    { "id": "stats-population", "operation": "table.statistics", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Mixed Use Program", "field": "pop" }, "dependsOn": ["stats-area"] },
    { "id": "stats-dwellings", "operation": "table.statistics", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Mixed Use Program", "field": "du" }, "dependsOn": ["stats-population"] },
    { "id": "stats-employment", "operation": "table.statistics", "arguments": { "map": "UD3 Mixed Use Program", "layer": "Mixed Use Program", "field": "emp" }, "dependsOn": ["stats-dwellings"] },
    { "id": "capture", "operation": "view.capture", "arguments": { "view": "layout", "layout": "Urban Test 3 - Mixed Use Massing", "width": 2400, "height": 1553 }, "dependsOn": ["stats-employment"], "expectedObservation": "mixed-use-layout-png" },
    { "id": "save", "operation": "project.save", "arguments": {}, "dependsOn": ["capture"] }
  ]
}
