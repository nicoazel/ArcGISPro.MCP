{
  "id": "workflow.urban-green-loop",
  "version": "1.1.0",
  "title": "Urban test 2 - green loop and stormwater network",
  "summary": "Builds a green-infrastructure test with open-space context, connected corridors, neighborhood nodes, and an exported review sheet.",
  "tags": ["urban-design", "green-infrastructure", "public-realm", "layout", "stress-test"],
  "requiredCapabilities": ["maps", "layouts", "visual-observations"],
  "parameters": [
    { "name": "zoningSource", "type": "path", "required": true, "description": "Illustrative parcel and land-use fixture." },
    { "name": "corridorSource", "type": "path", "required": true, "description": "Illustrative connected corridor fixture." },
    { "name": "pointsSource", "type": "path", "required": true, "description": "Illustrative neighborhood-node fixture." },
    { "name": "greenSitesSource", "type": "path", "required": true, "description": "Illustrative multipart green-infrastructure sites." },
    { "name": "proposalSource", "type": "path", "required": true, "description": "Synchronized development proposal feature class." }
  ],
  "steps": [
    { "id": "inspect", "operation": "project.get", "arguments": {}, "dependsOn": [] },
    { "id": "ensure-green", "operation": "map.ensure", "arguments": { "name": "UD2 Green Infrastructure", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["inspect"] },
    { "id": "ensure-open-space", "operation": "map.ensure", "arguments": { "name": "UD2 Open Space Context", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-green"] },
    { "id": "ensure-nodes", "operation": "map.ensure", "arguments": { "name": "UD2 Neighborhood Nodes", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-open-space"] },
    { "id": "green-sites", "operation": "layer.add", "arguments": { "map": "UD2 Green Infrastructure", "source": "${parameters.greenSitesSource}", "name": "Green Infrastructure Sites" }, "dependsOn": ["ensure-nodes"] },
    { "id": "style-green-sites", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Green Infrastructure", "layer": "Green Infrastructure Sites", "color": "#4F9B6B", "outlineColor": "#245B3A", "outlineWidth": 1.1 }, "dependsOn": ["green-sites"] },
    { "id": "green-corridors", "operation": "layer.add", "arguments": { "map": "UD2 Green Infrastructure", "source": "${parameters.corridorSource}", "name": "Green Loop Corridors" }, "dependsOn": ["style-green-sites"] },
    { "id": "style-green-corridors", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Green Infrastructure", "layer": "Green Loop Corridors", "color": "#2F7F62", "size": 3.0 }, "dependsOn": ["green-corridors"] },
    { "id": "green-proposal", "operation": "layer.add", "arguments": { "map": "UD2 Green Infrastructure", "source": "${parameters.proposalSource}", "name": "Development Interface" }, "dependsOn": ["style-green-corridors"] },
    { "id": "style-green-proposal", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Green Infrastructure", "layer": "Development Interface", "color": "#D6A14E", "outlineColor": "#6A4310", "outlineWidth": 0.8 }, "dependsOn": ["green-proposal"] },
    { "id": "open-space-parcels", "operation": "layer.add", "arguments": { "map": "UD2 Open Space Context", "source": "${parameters.zoningSource}", "name": "Open Space Context" }, "dependsOn": ["style-green-proposal"] },
    { "id": "style-open-space", "operation": "symbology.set-unique-values", "arguments": { "map": "UD2 Open Space Context", "layer": "Open Space Context", "field": "land_use_1", "defaultColor": "#E2E0D9", "classes": [ { "value": "parks_recreation", "label": "Parks + recreation", "color": "#79B56B" }, { "value": "civic_facilities", "label": "Civic landscape", "color": "#7FB0B8" }, { "value": "multifamily", "label": "Residential edge", "color": "#DEC99B" }, { "value": "retail_commercial", "label": "Active-use edge", "color": "#D99B85" } ] }, "dependsOn": ["open-space-parcels"] },
    { "id": "open-space-sites", "operation": "layer.add", "arguments": { "map": "UD2 Open Space Context", "source": "${parameters.greenSitesSource}", "name": "Priority Green Sites" }, "dependsOn": ["style-open-space"] },
    { "id": "style-open-space-sites", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Open Space Context", "layer": "Priority Green Sites", "color": "#2E8155", "outlineColor": "#FFFFFF", "outlineWidth": 1.0 }, "dependsOn": ["open-space-sites"] },
    { "id": "node-points", "operation": "layer.add", "arguments": { "map": "UD2 Neighborhood Nodes", "source": "${parameters.pointsSource}", "name": "Green Nodes" }, "dependsOn": ["style-open-space-sites"] },
    { "id": "style-nodes", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Neighborhood Nodes", "layer": "Green Nodes", "color": "#116B5C", "size": 8 }, "dependsOn": ["node-points"] },
    { "id": "node-corridors", "operation": "layer.add", "arguments": { "map": "UD2 Neighborhood Nodes", "source": "${parameters.corridorSource}", "name": "Connected Streets" }, "dependsOn": ["style-nodes"] },
    { "id": "style-node-corridors", "operation": "symbology.set-simple", "arguments": { "map": "UD2 Neighborhood Nodes", "layer": "Connected Streets", "color": "#8AA59A", "size": 1.2 }, "dependsOn": ["node-corridors"] },
    { "id": "ensure-layout", "operation": "layout.ensure", "arguments": { "name": "Urban Test 2 - Green Loop", "width": 17, "height": 11 }, "dependsOn": ["style-node-corridors"] },
    { "id": "green-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 2 - Green Loop", "map": "UD2 Green Infrastructure", "name": "Green Infrastructure Plan", "x": 0.55, "y": 1.25, "width": 9.45, "height": 8.2 }, "dependsOn": ["ensure-layout"] },
    { "id": "open-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 2 - Green Loop", "map": "UD2 Open Space Context", "name": "Open Space Context", "x": 10.25, "y": 5.7, "width": 6.2, "height": 3.75 }, "dependsOn": ["green-frame"] },
    { "id": "nodes-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 2 - Green Loop", "map": "UD2 Neighborhood Nodes", "name": "Neighborhood Nodes", "x": 10.25, "y": 1.25, "width": 6.2, "height": 3.75 }, "dependsOn": ["open-frame"] },
    { "id": "title", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "title", "text": "URBAN TEST 02  /  GREEN LOOP + STORMWATER NETWORK", "x": 0.55, "y": 10.36, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 23, "color": "#214E3C" }, "dependsOn": ["nodes-frame"] },
    { "id": "subtitle", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "subtitle", "text": "Connected open space, green streets, neighborhood nodes, and development interfaces", "x": 0.55, "y": 9.96, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 9, "color": "#5F756A" }, "dependsOn": ["title"] },
    { "id": "heading-green", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "heading-green", "text": "01  GREEN INFRASTRUCTURE PLAN", "x": 0.55, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 11, "color": "#214E3C" }, "dependsOn": ["subtitle"] },
    { "id": "heading-open", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "heading-open", "text": "02  OPEN-SPACE CONTEXT", "x": 10.25, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#214E3C" }, "dependsOn": ["heading-green"] },
    { "id": "heading-nodes", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "heading-nodes", "text": "03  NEIGHBORHOOD NODES", "x": 10.25, "y": 5.18, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#214E3C" }, "dependsOn": ["heading-open"] },
    { "id": "note", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "note", "text": "TEST HYPOTHESIS: link green sites through complete streets and distributed public-realm nodes to form a legible neighborhood loop.", "x": 0.55, "y": 0.72, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 8.5, "color": "#214E3C" }, "dependsOn": ["heading-nodes"] },
    { "id": "disclaimer", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "disclaimer", "text": "Illustrative automated test; corridor and node fixtures do not represent hydrologic performance or constructed infrastructure.", "x": 0.55, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 7.5, "color": "#6E7772" }, "dependsOn": ["note"] },
    { "id": "fit-green", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Green Infrastructure Plan", "layer": "Green Infrastructure Sites", "padding": 2.0 }, "dependsOn": ["disclaimer"] },
    { "id": "fit-open", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Open Space Context", "layer": "Priority Green Sites", "padding": 2.3 }, "dependsOn": ["fit-green"] },
    { "id": "fit-nodes", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Neighborhood Nodes", "layer": "Green Nodes", "padding": 1.6 }, "dependsOn": ["fit-open"] },
    { "id": "north", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Green Infrastructure Plan", "name": "Green North", "kind": "north-arrow", "x": 9.2, "y": 8.55, "width": 0.42, "height": 0.68 }, "dependsOn": ["fit-nodes"] },
    { "id": "scale", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Green Infrastructure Plan", "name": "Green Scale", "kind": "scale-bar", "x": 0.85, "y": 1.5, "width": 2.0, "height": 0.3 }, "dependsOn": ["north"] },
    { "id": "legend", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 2 - Green Loop", "frame": "Green Infrastructure Plan", "name": "Green Legend", "kind": "legend", "x": 7.6, "y": 1.55, "width": 2.0, "height": 2.4 }, "dependsOn": ["scale"] },
    { "id": "dynamic-status", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 2 - Green Loop", "name": "dynamic-status", "text": "PROJECT  <dyn type=\"project\" property=\"name\"/>  /  GENERATED  <dyn type=\"date\" format=\"short\"/>  /  SCALE  <dyn type=\"mapFrame\" name=\"Green Infrastructure Plan\" property=\"camera.scale\" preStr=\"1:\" decimalPlaces=\"0\"/>", "x": 10.25, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 6.5, "color": "#61706B" }, "dependsOn": ["legend"] },
    { "id": "stats-area", "operation": "table.statistics", "arguments": { "map": "UD2 Open Space Context", "layer": "Open Space Context", "field": "area_gross" }, "dependsOn": ["dynamic-status"] },
    { "id": "stats-population", "operation": "table.statistics", "arguments": { "map": "UD2 Open Space Context", "layer": "Open Space Context", "field": "pop" }, "dependsOn": ["stats-area"] },
    { "id": "stats-dwellings", "operation": "table.statistics", "arguments": { "map": "UD2 Open Space Context", "layer": "Open Space Context", "field": "du" }, "dependsOn": ["stats-population"] },
    { "id": "stats-employment", "operation": "table.statistics", "arguments": { "map": "UD2 Open Space Context", "layer": "Open Space Context", "field": "emp" }, "dependsOn": ["stats-dwellings"] },
    { "id": "capture", "operation": "view.capture", "arguments": { "view": "layout", "layout": "Urban Test 2 - Green Loop", "width": 2400, "height": 1553 }, "dependsOn": ["stats-employment"], "expectedObservation": "green-loop-layout-png" }
  ]
}
