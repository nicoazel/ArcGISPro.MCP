{
  "id": "workflow.urban-tod-corridor",
  "version": "1.2.0",
  "title": "Urban test 1 - transit-oriented corridor",
  "summary": "Builds a transit-oriented development test with program, mobility, and existing-fabric maps and exports a landscape review sheet.",
  "tags": ["urban-design", "tod", "mobility", "layout", "stress-test"],
  "requiredCapabilities": ["maps", "layouts", "visual-observations"],
  "parameters": [
    { "name": "zoningSource", "type": "path", "required": true, "description": "Illustrative parcel and land-use fixture." },
    { "name": "transitSource", "type": "path", "required": true, "description": "Illustrative street/transit corridor fixture." },
    { "name": "buildingsSource", "type": "path", "required": true, "description": "Existing building-footprint fixture." },
    { "name": "proposalSource", "type": "path", "required": true, "description": "Synchronized development proposal feature class." }
  ],
  "steps": [
    { "id": "inspect", "operation": "project.get", "arguments": {}, "dependsOn": [] },
    { "id": "ensure-program", "operation": "map.ensure", "arguments": { "name": "UD1 TOD Program", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["inspect"] },
    { "id": "ensure-mobility", "operation": "map.ensure", "arguments": { "name": "UD1 TOD Mobility", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-program"] },
    { "id": "ensure-fabric", "operation": "map.ensure", "arguments": { "name": "UD1 TOD Existing Fabric", "type": "map", "basemap": "GrayVector" }, "dependsOn": ["ensure-mobility"] },
    { "id": "program-parcels", "operation": "layer.add", "arguments": { "map": "UD1 TOD Program", "source": "${parameters.zoningSource}", "name": "Land Use Program" }, "dependsOn": ["ensure-fabric"] },
    { "id": "program-categories", "operation": "symbology.set-unique-values", "arguments": { "map": "UD1 TOD Program", "layer": "Land Use Program", "field": "land_use_1", "defaultColor": "#D8D7D2", "classes": [ { "value": "multifamily", "label": "Multifamily housing", "color": "#D8A657" }, { "value": "retail_commercial", "label": "Active ground floor", "color": "#C86B55" }, { "value": "office", "label": "Employment", "color": "#8172A8" }, { "value": "parks_recreation", "label": "Open space", "color": "#83AE70" }, { "value": "civic_facilities", "label": "Civic anchor", "color": "#5E9BB0" } ] }, "dependsOn": ["program-parcels"] },
    { "id": "program-proposal", "operation": "layer.add", "arguments": { "map": "UD1 TOD Program", "source": "${parameters.proposalSource}", "name": "Development Program" }, "dependsOn": ["program-categories"] },
    { "id": "style-program-proposal", "operation": "symbology.set-simple", "arguments": { "map": "UD1 TOD Program", "layer": "Development Program", "color": "#8B2F67", "outlineColor": "#4A1636", "outlineWidth": 1.0 }, "dependsOn": ["program-proposal"] },
    { "id": "label-program", "operation": "label.configure", "arguments": { "map": "UD1 TOD Program", "layer": "Development Program", "enabled": true, "expression": "'Building ' + Text($feature.OBJECTID)", "fontFamily": "Aptos", "fontStyle": "Semibold", "size": 8, "color": "#4A1636" }, "dependsOn": ["style-program-proposal"] },
    { "id": "mobility-lines", "operation": "layer.add", "arguments": { "map": "UD1 TOD Mobility", "source": "${parameters.transitSource}", "name": "Transit Spine" }, "dependsOn": ["label-program"] },
    { "id": "style-mobility", "operation": "symbology.set-simple", "arguments": { "map": "UD1 TOD Mobility", "layer": "Transit Spine", "color": "#137F8C", "size": 2.8 }, "dependsOn": ["mobility-lines"] },
    { "id": "mobility-proposal", "operation": "layer.add", "arguments": { "map": "UD1 TOD Mobility", "source": "${parameters.proposalSource}", "name": "TOD Sites" }, "dependsOn": ["style-mobility"] },
    { "id": "style-mobility-proposal", "operation": "symbology.set-simple", "arguments": { "map": "UD1 TOD Mobility", "layer": "TOD Sites", "color": "#F0A74B", "outlineColor": "#693D10", "outlineWidth": 0.9 }, "dependsOn": ["mobility-proposal"] },
    { "id": "fabric-buildings", "operation": "layer.add", "arguments": { "map": "UD1 TOD Existing Fabric", "source": "${parameters.buildingsSource}", "name": "Existing Buildings" }, "dependsOn": ["style-mobility-proposal"] },
    { "id": "style-fabric", "operation": "symbology.set-simple", "arguments": { "map": "UD1 TOD Existing Fabric", "layer": "Existing Buildings", "color": "#C7CBC8", "outlineColor": "#69716C", "outlineWidth": 0.35 }, "dependsOn": ["fabric-buildings"] },
    { "id": "fabric-proposal", "operation": "layer.add", "arguments": { "map": "UD1 TOD Existing Fabric", "source": "${parameters.proposalSource}", "name": "Development Program" }, "dependsOn": ["style-fabric"] },
    { "id": "style-fabric-proposal", "operation": "symbology.set-simple", "arguments": { "map": "UD1 TOD Existing Fabric", "layer": "Development Program", "color": "#8B2F67", "outlineColor": "#FFFFFF", "outlineWidth": 1.1 }, "dependsOn": ["fabric-proposal"] },
    { "id": "ensure-layout", "operation": "layout.ensure", "arguments": { "name": "Urban Test 1 - TOD Corridor", "width": 17, "height": 11 }, "dependsOn": ["style-fabric-proposal"] },
    { "id": "program-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "map": "UD1 TOD Program", "name": "Program Plan", "x": 0.55, "y": 1.25, "width": 9.45, "height": 8.2 }, "dependsOn": ["ensure-layout"] },
    { "id": "mobility-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "map": "UD1 TOD Mobility", "name": "Mobility Structure", "x": 10.25, "y": 5.7, "width": 6.2, "height": 3.75 }, "dependsOn": ["program-frame"] },
    { "id": "fabric-frame", "operation": "layout.add-map-frame", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "map": "UD1 TOD Existing Fabric", "name": "Existing Fabric", "x": 10.25, "y": 1.25, "width": 6.2, "height": 3.75 }, "dependsOn": ["mobility-frame"] },
    { "id": "title", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "title", "text": "URBAN TEST 01  /  TRANSIT-ORIENTED CORRIDOR", "x": 0.55, "y": 10.36, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 23, "color": "#38243B" }, "dependsOn": ["fabric-frame"] },
    { "id": "subtitle", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "subtitle", "text": "Mixed-use intensity, mobility structure, and fit with existing urban fabric", "x": 0.55, "y": 9.96, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 9, "color": "#6E5A70" }, "dependsOn": ["title"] },
    { "id": "heading-program", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "heading-program", "text": "01  DEVELOPMENT PROGRAM", "x": 0.55, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 11, "color": "#38243B" }, "dependsOn": ["subtitle"] },
    { "id": "heading-mobility", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "heading-mobility", "text": "02  TRANSIT + WALKABILITY", "x": 10.25, "y": 9.62, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#38243B" }, "dependsOn": ["heading-program"] },
    { "id": "heading-fabric", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "heading-fabric", "text": "03  EXISTING FABRIC", "x": 10.25, "y": 5.18, "fontFamily": "Aptos", "fontStyle": "Bold", "size": 10.5, "color": "#38243B" }, "dependsOn": ["heading-mobility"] },
    { "id": "note", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "note", "text": "TEST HYPOTHESIS: concentrate housing and active uses along the transit spine while retaining a legible neighborhood grain.", "x": 0.55, "y": 0.72, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 8.5, "color": "#38243B" }, "dependsOn": ["heading-fabric"] },
    { "id": "disclaimer", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "disclaimer", "text": "Illustrative automated test using synthetic fixtures; not a planning recommendation or authoritative transit analysis.", "x": 0.55, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 7.5, "color": "#766F77" }, "dependsOn": ["note"] },
    { "id": "fit-program", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Program Plan", "layer": "Development Program", "padding": 2.0 }, "dependsOn": ["disclaimer"] },
    { "id": "fit-mobility", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Mobility Structure", "layer": "TOD Sites", "padding": 2.5 }, "dependsOn": ["fit-program"] },
    { "id": "fit-fabric", "operation": "layout.set-frame-extent", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Existing Fabric", "layer": "Development Program", "padding": 2.2 }, "dependsOn": ["fit-mobility"] },
    { "id": "north", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Program Plan", "name": "TOD North", "kind": "north-arrow", "x": 9.2, "y": 8.55, "width": 0.42, "height": 0.68 }, "dependsOn": ["fit-fabric"] },
    { "id": "scale", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Program Plan", "name": "TOD Scale", "kind": "scale-bar", "x": 0.85, "y": 1.75, "width": 2.6, "height": 0.3 }, "dependsOn": ["north"] },
    { "id": "legend", "operation": "layout.ensure-surround", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "frame": "Program Plan", "name": "TOD Legend", "kind": "legend", "x": 7.5, "y": 2.0, "width": 2.3, "height": 2.6 }, "dependsOn": ["scale"] },
    { "id": "dynamic-status", "operation": "layout.set-text", "arguments": { "layout": "Urban Test 1 - TOD Corridor", "name": "dynamic-status", "text": "PROJECT  <dyn type=\"project\" property=\"name\"/>  /  GENERATED  <dyn type=\"date\" format=\"short\"/>  /  SCALE  <dyn type=\"mapFrame\" name=\"Program Plan\" property=\"camera.scale\" preStr=\"1:\" decimalPlaces=\"0\"/>", "x": 10.25, "y": 0.38, "fontFamily": "Aptos", "fontStyle": "Regular", "size": 6.5, "color": "#766F77" }, "dependsOn": ["legend"] },
    { "id": "stats-area", "operation": "table.statistics", "arguments": { "map": "UD1 TOD Program", "layer": "Land Use Program", "field": "area_gross" }, "dependsOn": ["dynamic-status"] },
    { "id": "stats-population", "operation": "table.statistics", "arguments": { "map": "UD1 TOD Program", "layer": "Land Use Program", "field": "pop" }, "dependsOn": ["stats-area"] },
    { "id": "stats-dwellings", "operation": "table.statistics", "arguments": { "map": "UD1 TOD Program", "layer": "Land Use Program", "field": "du" }, "dependsOn": ["stats-population"] },
    { "id": "stats-employment", "operation": "table.statistics", "arguments": { "map": "UD1 TOD Program", "layer": "Land Use Program", "field": "emp" }, "dependsOn": ["stats-dwellings"] },
    { "id": "capture", "operation": "view.capture", "arguments": { "view": "layout", "layout": "Urban Test 1 - TOD Corridor", "width": 2400, "height": 1553 }, "dependsOn": ["stats-employment"], "expectedObservation": "tod-layout-png" }
  ]
}
